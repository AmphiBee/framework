# Start command: vendor/bin/phpstan analyse

includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon
    - phpstan-baseline.neon
parameters:
    level: 2
    paths:
        - src/
    excludePaths:
        - src/Page/views
        - src/Core/Exceptions/views
        - src/Taxonomy/views
        - src/PostType/views
        - src/Forms/views
        - src/Auth/Console/stubs
        - src/User/views
        - src/Core/Console/stubs
        - src/Core/stubs
