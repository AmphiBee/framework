{
  "name": "themosis/framework",
  "description": "The Themosis framework.",
  "keywords": ["themosis", "framework", "wordpress"],
  "license": "GPL-2.0-or-later",
  "support": {
    "issues": "https://github.com/themosis/framework/issues",
    "source": "https://github.com/themosis/framework"
  },
  "authors": [
    {
      "name": "Julien Lambé",
      "email": "julien@themosis.com",
      "homepage": "https://www.themosis.com/"
    }
  ],
  "autoload": {
    "psr-4": {
      "Themosis\\": "src/"
    },
    "files": [
      "src/Core/aliases.php",
      "src/Core/helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Themosis\\Tests\\": "tests/"
    }
  },
  "require": {
    "php": "^8.2",
    "ext-ctype": "*",
    "ext-filter": "*",
    "ext-hash": "*",
    "ext-intl": "*",
    "ext-mbstring": "*",
    "ext-openssl": "*",
    "ext-session": "*",
    "ext-tokenizer": "*",
    "composer-runtime-api": "^2.2",
    "composer/installers": "^2.2",
    "dragonmantank/cron-expression": "^3.4",
    "filp/whoops": "^2.16",
    "guzzlehttp/guzzle": "^7.8.2",
    "illuminate/auth": "^12.68",
    "illuminate/broadcasting": "^12.68",
    "illuminate/bus": "^12.68",
    "illuminate/cache": "^12.68",
    "illuminate/collections": "^12.68",
    "illuminate/conditionable": "^12.68",
    "illuminate/config": "^12.68",
    "illuminate/console": "^12.68",
    "illuminate/container": "^12.68",
    "illuminate/contracts": "^12.68",
    "illuminate/cookie": "^12.68",
    "illuminate/database": "^12.68",
    "illuminate/encryption": "^12.68",
    "illuminate/events": "^12.68",
    "illuminate/filesystem": "^12.68",
    "illuminate/hashing": "^12.68",
    "illuminate/http": "^12.68",
    "illuminate/log": "^12.68",
    "illuminate/macroable": "^12.68",
    "illuminate/mail": "^12.68",
    "illuminate/notifications": "^12.68",
    "illuminate/pagination": "^12.68",
    "illuminate/pipeline": "^12.68",
    "illuminate/queue": "^12.68",
    "illuminate/redis": "^12.68",
    "illuminate/routing": "^12.68",
    "illuminate/session": "^12.68",
    "illuminate/support": "^12.68",
    "illuminate/testing": "^12.68",
    "illuminate/translation": "^12.68",
    "illuminate/validation": "^12.68",
    "illuminate/view": "^12.68",
    "laravel/tinker": "^2.10",
    "laravel/ui": "^4.5",
    "laravel/serializable-closure": "^1.3|^2.0",
    "league/flysystem": "^3.8.0",
    "league/fractal": "^0.20.1",
    "nesbot/carbon": "^3.8.4",
    "paragonie/sodium_compat": "^1.15",
    "predis/predis": "^2.0.2",
    "ramsey/uuid": "^4.7",
    "spatie/enum": "^3.11.1",
    "symfony/property-access": "^7.0",
    "twig/twig": "^3.14",
    "vlucas/phpdotenv": "^5.5"
  },
  "require-dev": {
    "beyondcode/laravel-dump-server": "^2.0",
    "driftingly/rector-laravel": "^2.0",
    "fakerphp/faker": "^1.9.1",
    "johnpbloch/wordpress-core": "^6.0",
    "laravel/pint": "^1.24",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^11.5",
    "rector/rector": "^2.0",
    "symfony/var-dumper": "^7.0",
    "szepeviktor/phpstan-wordpress": "^2.0"
  },
  "scripts": {
    "test": "phpunit",
    "fix": "pint"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "composer/installers": true
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
